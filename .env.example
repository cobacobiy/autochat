# Provider AI yang digunakan: "ollama", "gemini", atau "claude"
AI_PROVIDER=ollama

# Konfigurasi Ollama (Lokal)
OLLAMA_MODEL=qwen2
OLLAMA_URL=http://localhost:11434

# Konfigurasi Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Konfigurasi Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Format Log (text atau json)
LOG_FORMAT=text

# Konfigurasi Bot
POLL_INTERVAL=5
MAX_DAILY_REPLIES=5000

# Auto-login Credentials (Opsional, jika ingin bot auto-login)
# ⚠️ JANGAN commit file .env! Pastikan .env ada di .gitignore
# Konfigurasi Akun Bot 1
BOT1_SHOPEE_USERNAME=
BOT1_SHOPEE_PASSWORD=

# Konfigurasi Akun Bot 2
BOT2_SHOPEE_USERNAME=
BOT2_SHOPEE_PASSWORD=

# Konfigurasi Akun Bot 3
BOT3_SHOPEE_USERNAME=
BOT3_SHOPEE_PASSWORD=
