# Provider AI yang digunakan: "ollama", "gemini", atau "claude"
AI_PROVIDER=ollama

# Konfigurasi Ollama (Lokal)
OLLAMA_MODEL=qwen2
OLLAMA_URL=http://localhost:11434

# Konfigurasi Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Konfigurasi Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# Format Log (text atau json)
LOG_FORMAT=text

# Konfigurasi Bot
POLL_INTERVAL=5
MAX_DAILY_REPLIES=500
